    "engine": "node --import tsx server/index.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "dexie": "^4.4.4",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.6.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-chessboard": "^5.10.0",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0",
    "stockfish": "^18.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
